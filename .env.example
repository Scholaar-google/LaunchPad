DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
QDRANT_URL=http://localhost:6333
DATABASE_URL=postgresql://user:password@localhost:5432/launchpad
MAX_DIALOG_TURNS=3
CONFIDENCE_THRESHOLD=0.7
ENABLE_REASONING_STREAM=true
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT=30
PARALLEL_AGENT_TIMEOUT=60
CORPORATE_STRATEGY=balanced

# ---- 按 Agent 独立 LLM 配置（JSON，可选。未配置字段使用全局默认） ----
# agent_llm_config 格式:
# {"intake":{"api_key":"sk-xxx","base_url":"https://api.openai.com","model":"gpt-4o"},"synthesis":{"model":"claude-sonnet-4-20250514"}}
# 支持的 agent 名称: intake, dispatch, feasibility, resource, risk, synthesis, review
# 每个 agent 的 api_key / base_url / model 均可选，缺省分别回退到 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / LLM_MODEL
AGENT_LLM_CONFIG={"intake":{},"dispatch":{},"feasibility":{},"resource":{},"risk":{},"synthesis":{},"review":{}}
